{
  "pipeline": {
    "input_file": "companies.xlsx",
    "company_name_column": "company_name",
    "description_column": "description",
    "domain_column": "domain",
    "uen_column": "uen",
    "checkpoint_interval": 10
  },
  "llm": {
    "provider": "anthropic",
    "model": null,
    "tier": "fast",
    "max_tokens_classifier": 2000,
    "max_tokens_validator": 2000,
    "temperature": 0.1,
    "max_retries_on_parse_error": 2
  },
  "validation": {
    "validator_threshold": 70,
    "max_web_searches": 3,
    "validator_enabled": true,
    "override_min_confidence": 65
  },
  "confidence": {
    "epo_adjust_max": 15,
    "low_evidence_cap": 60
  },
  "epo": {
    "epo_package_dir": "./lib/epo_patent",
    "enabled": true
  },
  "enrichment": {
    "enabled": true,
    "max_searches": 2,
    "max_tokens": 1000
  },
  "batch": {
    "enabled": true,
    "batch_poll_interval_s": 30
  }
}
